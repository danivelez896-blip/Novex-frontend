# Novex isolated staging setup (copy values to .env.local only in a SEPARATE frontend checkout)
# Do not use this configuration in the production frontend checkout.
NOVEX_API_URL=https://diligent-reverence-staging.up.railway.app
SUPABASE_URL=https://rlcmjaqkhajkaaqqowga.supabase.co
# Obtain from Supabase > Novex Staging > Project Settings > API Keys
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
# Leave disabled until full exchange flow is validated
NEXT_PUBLIC_ENABLE_EXCHANGE_TEST_UI=false
# Fail closed: real refunds and paid shipping stay unavailable until launch validation.
NEXT_PUBLIC_ENABLE_REAL_ECONOMIC_ACTIONS=false
